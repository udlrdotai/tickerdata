{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tickerdata.local/schemas/vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "industry_systems", "themes", "tags"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "themes": { "type": "array", "items": { "$ref": "common#/definitions/label" } },
    "tags": { "type": "array", "items": { "$ref": "common#/definitions/label" } },
    "industry_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh", "description", "aliases", "sectors", "industry_groups", "industries"],
        "properties": {
          "id": { "$ref": "common#/definitions/id" },
          "name_zh": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "sectors": { "type": "array", "items": { "$ref": "common#/definitions/label" } },
          "industry_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name_zh", "description", "aliases", "sector_id"],
              "properties": {
                "id": { "$ref": "common#/definitions/id" },
                "name_zh": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "sector_id": { "$ref": "common#/definitions/id" }
              }
            }
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name_zh", "description", "aliases", "sector_id", "industry_group_id"],
              "properties": {
                "id": { "$ref": "common#/definitions/id" },
                "name_zh": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "sector_id": { "$ref": "common#/definitions/nullableId" },
                "industry_group_id": { "$ref": "common#/definitions/nullableId" }
              }
            }
          }
        }
      }
    }
  }
}
