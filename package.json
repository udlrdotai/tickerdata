{
  "name": "tickerdata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prevalidate": "node scripts/compile-schemas.js",
    "validate": "node scripts/cli.js validate",
    "prebuild": "node scripts/compile-schemas.js",
    "build": "node scripts/cli.js build",
    "pretest": "node scripts/compile-schemas.js",
    "test": "node --test tests/*.test.js",
    "build:packages": "npm run build && node scripts/build-packages.js",
    "test:packages": "node --test packages/node/test/*.test.cjs packages/tests/*.test.js && PYTHONPATH=packages/python/src python3 -m unittest discover -s packages/python/tests -p 'test_*.py'",
    "pack:packages": "node scripts/pack-packages.js",
    "test:web": "npm run build && node --test tests-browser/*.test.js",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist",
    "presuggestion:validate": "node scripts/compile-schemas.js",
    "suggestion:validate": "node scripts/cli.js suggestion",
    "premigrate": "node scripts/compile-schemas.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "wrangler": "^4.130.0"
  }
}
